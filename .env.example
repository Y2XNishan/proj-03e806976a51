# Backend settings. Export in your shell or set in your deployment environment.
# Elexon stream reads need no credentials. The bundled snapshot serves by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DAY_AHEAD_CUTOFF_LOCAL=12:00
# Optional local cache location; default is backend/data/elexon.sqlite3.
# ELEXON_CACHE_PATH=backend/data/elexon.sqlite3
# Set on deployments to require the source-backed bundle.
# SNAPSHOT_REQUIRED=1

